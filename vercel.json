{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "FR" }],
      "missing": [{ "type": "cookie", "key": "lang" }],
      "destination": "/fr/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "NL" }],
      "missing": [{ "type": "cookie", "key": "lang" }],
      "destination": "/nl/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": "DE" }],
      "missing": [{ "type": "cookie", "key": "lang" }],
      "destination": "/de/",
      "permanent": false
    },
    {
      "source": "/fr",
      "destination": "/fr/",
      "permanent": true
    },
    {
      "source": "/nl",
      "destination": "/nl/",
      "permanent": true
    },
    {
      "source": "/de",
      "destination": "/de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "replate-barcelona-site.vercel.app" }],
      "destination": "https://replatebarcelona.com/:path*",
      "permanent": true
    }
  ]
}
